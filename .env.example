# ── API ───────────────────────────────────────────────────────────────
PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated list of allowed browser origins. Empty = allow any origin.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ── Database ──────────────────────────────────────────────────────────
# Dev (Docker):  set automatically to file:/data/dev.db by docker-compose.dev.yml
# Dev (host):    leave empty -> defaults to packages/db/dev.db
# Production:    Turso, e.g. libsql://invitera-yourorg.turso.io + auth token
DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── Seed (bun db:seed) ────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@invitera.local
SEED_ADMIN_PASSWORD=admin12345
SEED_ADMIN_NAME=Invitera Admin

# ── Frontends (Vite, development) ─────────────────────────────────────
# Browser-facing URL of the API during development.
VITE_API_URL=http://localhost:3000
# Public web app URL, used by the admin app to link to invitations.
VITE_WEB_URL=http://localhost:5173

# ── Production compose (docker-compose.prod.yml) ──────────────────────
WEB_PORT=8080
ADMIN_PORT=8081
# Public URL of the deployed web app, baked into the admin build so it can
# link to live invitations (e.g. https://invitations.example.com).
PUBLIC_WEB_URL=
